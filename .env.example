# STARSKY — Supabase & Application Environment Template
# Copy this file to .env.local and fill in your Supabase project credentials.

# 1. Supabase Public Configuration (Required for Live Supabase PostgreSQL / Auth / Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Supabase Server-Only Service Role Key (NEVER expose in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Application Secret for signed session tokens & admin protection
STARSKY_SESSION_SECRET=replace-with-a-strong-32-character-random-secret-key

# 4. Initial Super Admin Bootstrap Credentials (server-only)
STARSKY_ADMIN_EMAIL=admin@starsky.edu
STARSKY_ADMIN_PASSWORD=ChangeMeImmediately!2026

